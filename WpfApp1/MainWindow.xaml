<Window x:Class="OPL_WpfApp.MainWindow_opl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:test="clr-namespace:test"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.Height="40" ui:TitleBar.IsIconVisible="True"
        Title="OpenP2P Launcher · 联机工具"
        Width="1060" Height="640" MinWidth="980" MinHeight="540"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        KeyboardNavigation.TabNavigation="Continue"
        StateChanged="Window_StateChanged" Activated="Show" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#327F7F7F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,7"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingSwitch" TargetType="ui:ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Width" Value="174"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="TextElement.FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="grid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTabs" BorderBrush="{x:Null}" TabStripPlacement="Left" Margin="8,8,8,0"
                    ui:TabControlHelper.IsAddTabButtonVisible="False"
                    SelectionChanged="MainTabs_SelectionChanged">
            <ui:TabControlHelper.TabStripFooter>
                <Button Click="Button_help" Width="194" Height="48" Margin="10" Padding="14,10"
                        AutomationProperties.Name="获取帮助">
                    <ui:IconAndText Icon="{x:Static ui:FluentSystemIcons.Lightbulb_20_Regular}"
                                    x:Name="Theme" Content="获取帮助"/>
                </Button>
            </ui:TabControlHelper.TabStripFooter>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource NavHeader}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Link_20_Regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="隧道" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="隧道管理" Style="{StaticResource PageTitle}"/>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="本机 UID" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" x:Name="UID" IsReadOnly="True" Text="AAAAAAAAAAAAAAAA" FontFamily="Consolas"/>
                            <Button Grid.Column="2" Content="复制" Click="CopyUID_Button_Click" Margin="8,0,20,0"/>
                            <TextBlock Grid.Column="3" Text="共享带宽" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="4" x:Name="share" Width="54" TextChanged="share_TextChanged"/>
                            <TextBlock Grid.Column="5" Text="Mbps" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Button Grid.Column="6" x:Name="QuickAddButton" Content="快速添加" Click="Quick_Add" Margin="12,0,8,0" ToolTip="从剪贴板中的联机码自动添加"/>
                            <Button Grid.Column="7" x:Name="NewConnectionButton" Content="新建连接" Click="Button_Click" Padding="16,8"
                                    Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="sdlist"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
                                 AutomationProperties.Name="隧道列表">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Border Padding="32" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=sdlist}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.LinkAdd_24_Regular}"
                                             FontSize="32" Opacity="0.7" HorizontalAlignment="Center"/>
                                <TextBlock Text="还没有隧道" FontSize="18" FontWeight="SemiBold"
                                           TextAlignment="Center" Margin="0,12,0,6"/>
                                <TextBlock Text="点击“新建连接”，或从剪贴板中的联机码快速添加。"
                                           Style="{StaticResource Caption}" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource NavHeader}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="EasyTier" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="EasyTier 组网" Style="{StaticResource PageTitle}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*" MinWidth="280"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="网络节点" Style="{StaticResource SectionTitle}"/>
                                <ListBox Grid.Row="1" x:Name="NetworkList" Margin="0,8,0,0"
                                         BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="EasyTier 网络节点">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="连接设置" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="当前网络" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="newetuid" Text="未连接" IsReadOnly="True" Margin="0,4,0,14"/>
                                <TextBlock Text="节点地址" Style="{StaticResource Caption}"/>
                                <Border Margin="0,4,0,6" Padding="8,8,2,2" MinHeight="48" MaxHeight="104"
                                        CornerRadius="8" BorderBrush="#327F7F7F" BorderThickness="1" Background="#0AFFFFFF">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="EasyTierPeersList" AutomationProperties.Name="EasyTier 节点列表">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,6" Padding="8,4,4,4" CornerRadius="14"
                                                            Background="#147F7F7F" BorderBrush="#327F7F7F" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                            <Button Tag="{Binding}" Click="RemoveEasyTierPeer_Click"
                                                                    Width="24" Height="24" Margin="6,0,0,0" Padding="0"
                                                                    ToolTip="删除节点" AutomationProperties.Name="删除节点">
                                                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Dismiss_12_Regular}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="EasyTierPeerInput" KeyDown="EasyTierPeerInput_KeyDown"
                                             ToolTip="输入节点地址；可一次粘贴多个地址"/>
                                    <Button Grid.Column="2" Content="添加" Click="AddEasyTierPeer_Click"/>
                                </Grid>
                                <Button x:Name="CreateEasyTierButton" Content="创建网络" Click="crearEtNet" Margin="0,0,0,18" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                                <TextBlock Text="加入已有网络" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="etNetText" Margin="0,4,0,8" ToolTip="输入网络 UID"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="JoinEasyTierButton" Content="加入网络" Click="joinEtNet"/>
                                    <Button Grid.Column="2" x:Name="LeaveEasyTierButton" Content="退出网络" Click="leaveEtNet"/>
                                </Grid>
                                <Button Content="查看帮助" Click="EThelp" Margin="0,14,0,0"/>
                                <TextBlock Text="实验性功能 · 由 EasyTier 提供服务" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource NavHeader}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="OpenP2P" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="OpenP2P 虚拟组网" Style="{StaticResource PageTitle}"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="创建网络" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="通讯端口" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="tunport" Text="25674" Margin="0,4,0,16"/>
                                <TextBlock Text="创建后会自动生成联机码，其他成员可通过右侧加入。" Style="{StaticResource Caption}" Margin="0,0,0,20"/>
                                <Button x:Name="tunbutton" Content="创建/开启网络" Click="Opentun" Height="40" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="加入网络" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="本机 IP 末位（2–20，且不可重复）" Style="{StaticResource Caption}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                    <TextBlock Text="10.0.23." VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="tunip" Text="2" Width="64"/>
                                </StackPanel>
                                <TextBlock Text="联机码" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="tunlink" Margin="0,4,0,16"/>
                                <Button x:Name="tunjoinbutton" Content="连接网络" Click="jointun" Height="40"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid x:Name="tunHaloHost" Width="12" Height="20" Margin="0,0,8,0">
                                <Ellipse x:Name="tunellipse" Fill="Gray" Stroke="#667F7F7F" Width="12" Height="12"
                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="组网状态" VerticalAlignment="Center"/>
                            <Label Grid.Column="2" x:Name="tunspeed" Content="流量信息" VerticalAlignment="Center" Margin="16,0"/>
                            <TextBox Grid.Column="3" x:Name="iptext" IsReadOnly="True" Width="180" Margin="0,0,8,0"/>
                            <Button Grid.Column="4" Content="复制 IP" Click="copytunip"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WindowConsole_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="日志" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="运行日志" Style="{StaticResource PageTitle}"/>
                    <TextBox Grid.Row="1" x:Name="richOutput" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="运行日志"/>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Speaker2_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="公告" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="公告" Style="{StaticResource PageTitle}"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="notice" AutomationProperties.Name="公告列表">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding time}" Style="{StaticResource Caption}" Margin="24,3,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding content}" Margin="0,14,0,0" LineHeight="22" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Settings_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="设置" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,16,16,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                        <Grid Grid.Row="1" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <!-- 左列 -->
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="启动与维护" Style="{StaticResource SectionTitle}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="校验 openp2p 文件" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="启动时校验核心文件完整性并自动修复" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="Autoup_opn" Style="{StaticResource SettingSwitch}" Toggled="Autoup_opn_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="自动更新 EasyTier 核心" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="保持 EasyTier 与服务端兼容" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="Autoup_etn" Style="{StaticResource SettingSwitch}" Toggled="Autoup_etn_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="自动更新主程序" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="有新版本时自动下载更新" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="Autoupn" Style="{StaticResource SettingSwitch}" Toggled="Autoupn_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="开机自动运行" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="Autoup_bootn" Style="{StaticResource SettingSwitch}" Toggled="Autoup_bootn_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="启动程序后自动开启服务" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="Autoup_openn" Style="{StaticResource SettingSwitch}" Toggled="Autoup_openn_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="启动后最小化到托盘" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="MinimizeOnStartupToggle" Style="{StaticResource SettingSwitch}" Toggled="MinimizeOnStartup_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="minimize" Style="{StaticResource SettingSwitch}" Toggled="minimize_Toggled"/>
                                        </Grid>
                                        <Button Content="添加 Windows 安全中心排除项" Click="AddMpBotton" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="通知与提示" Style="{StaticResource SectionTitle}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="显示运营商检测警告" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="Ispwarning" Style="{StaticResource SettingSwitch}" Toggled="Ispwarning_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="新公告弹窗提醒" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="NoticePopupToggle" Style="{StaticResource SettingSwitch}" Toggled="NoticePopup_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="托盘气泡通知" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="服务连接/断开时弹出气泡提醒" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="TrayBalloonToggle" Style="{StaticResource SettingSwitch}" Toggled="TrayBalloon_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="隧道连成时弹窗提醒" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="联机成功后主动弹出提示窗" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="ToastTunnelToggle" Style="{StaticResource SettingSwitch}" Toggled="ToastTunnel_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="关闭窗口时询问处理方式" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="开启后每次关闭都会询问隐藏或退出" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="AskOnCloseToggle" Style="{StaticResource SettingSwitch}" Toggled="AskOnClose_Toggled"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="日志与缓存" Style="{StaticResource SectionTitle}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="写入日志文件" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="FileLogToggle" Style="{StaticResource SettingSwitch}" Toggled="FileLog_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="日志显示时间戳" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="TimestampToggle" Style="{StaticResource SettingSwitch}" Toggled="Timestamp_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="退出时清理日志缓存" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="CleanLogCheck" Style="{StaticResource SettingSwitch}" Toggled="CleanLog_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="界面日志最大行数" Style="{StaticResource SettingLabel}"/>
                                            <ComboBox Grid.Column="1" x:Name="LogLinesCombo" SelectionChanged="LogLinesCombo_SelectionChanged">
                                                <ComboBoxItem Content="100"/><ComboBoxItem Content="300"/><ComboBoxItem Content="500"/><ComboBoxItem Content="1000"/><ComboBoxItem Content="2000"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="后台时暂缓日志刷新" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="窗口隐藏时只缓冲不刷新界面，显著降低占用" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="BackgroundLogToggle" Style="{StaticResource SettingSwitch}" Toggled="BackgroundLog_Toggled"/>
                                        </Grid>
                                        <Button Content="导出日志成压缩包" Click="ExportLog" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 右列 -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="外观与动效" Style="{StaticResource SectionTitle}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="应用主题" Style="{StaticResource SettingLabel}"/>
                                            <ComboBox Grid.Column="1" x:Name="ThemeComboBox" SelectionChanged="ThemeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="跟随系统" x:Name="Theme_auto"/><ComboBoxItem Content="浅色" x:Name="Theme_Light"/><ComboBoxItem Content="深色" x:Name="Theme_Dark"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="界面字号" Style="{StaticResource SettingLabel}"/>
                                            <ComboBox Grid.Column="1" x:Name="UiFontCombo" SelectionChanged="UiFontCombo_SelectionChanged">
                                                <ComboBoxItem Content="特小 (12)"/><ComboBoxItem Content="偏小 (13)"/><ComboBoxItem Content="标准 (14)"/><ComboBoxItem Content="偏大 (16)"/><ComboBoxItem Content="特大 (18)"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="窗口背景材质" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="无材质可进一步降低 GPU 占用" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="BackdropCombo" SelectionChanged="BackdropCombo_SelectionChanged">
                                                <ComboBoxItem Content="Mica"/><ComboBoxItem Content="Acrylic"/><ComboBoxItem Content="无材质"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="界面动画效果" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="关闭后页面切换瞬时完成，低配机器推荐" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="AnimToggle" Style="{StaticResource SettingSwitch}" Toggled="Anim_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="紧凑导航栏（仅图标）" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="CompactNavToggle" Style="{StaticResource SettingSwitch}" Toggled="CompactNav_Toggled"/>
                                        </Grid>
                                        <TextBlock Text="强调色" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                                        <test:ColorPicker x:Name="ColorBlock" SelectColor="Black" Height="40" Margin="0,4,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Content="应用颜色" Click="ColorPicker_Set" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
                                            <Button Grid.Column="2" Content="恢复系统配色" Click="ColorPicker_ReSet"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="性能与资源" Style="{StaticResource SectionTitle}"/>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="运行模式" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="影响状态刷新频率与后台占用" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="PerfModeCombo" SelectionChanged="PerfModeCombo_SelectionChanged">
                                                <ComboBoxItem Content="高性能"/><ComboBoxItem Content="平衡"/><ComboBoxItem Content="省电"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="状态刷新间隔" Style="{StaticResource SettingLabel}"/>
                                            <ComboBox Grid.Column="1" x:Name="EtPollCombo" SelectionChanged="EtPollCombo_SelectionChanged">
                                                <ComboBoxItem Content="2 秒"/><ComboBoxItem Content="5 秒"/><ComboBoxItem Content="10 秒"/><ComboBoxItem Content="30 秒"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="流量刷新间隔" Style="{StaticResource SettingLabel}"/>
                                            <ComboBox Grid.Column="1" x:Name="TrafficPollCombo" SelectionChanged="TrafficPollCombo_SelectionChanged">
                                                <ComboBoxItem Content="1 秒"/><ComboBoxItem Content="2 秒"/><ComboBoxItem Content="5 秒"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="最小化时回收内存" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="触发 GC 并清空工作集，托盘驻留占用 &lt;10MB" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="TrimMinimizeToggle" Style="{StaticResource SettingSwitch}" Toggled="TrimMinimize_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="隐藏到托盘后深度回收" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="AggressiveTrimToggle" Style="{StaticResource SettingSwitch}" Toggled="AggressiveTrim_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="联机期间阻止系统休眠" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="KeepAwakeToggle" Style="{StaticResource SettingSwitch}" Toggled="KeepAwake_Toggled"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="连接细节" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="参与者必须使用相同节点。备用节点仅建议在主节点失效时临时使用。" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="ServersCombo" SelectionChanged="ServersCombo_SelectionChanged" Margin="0,0,0,12"><ComboBoxItem Content="正在获取节点…" IsSelected="True"/></ComboBox>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="新建隧道默认协议" Style="{StaticResource SettingLabel}"/>
                                            <ComboBox Grid.Column="1" x:Name="DefaultProtocolCombo" SelectionChanged="DefaultProtocolCombo_SelectionChanged">
                                                <ComboBoxItem Content="tcp"/><ComboBoxItem Content="udp"/>
                                            </ComboBox>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="创建组网后自动复制联机码" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="AutoCopyCodeToggle" Style="{StaticResource SettingSwitch}" Toggled="AutoCopyCode_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="关闭所有隧道前二次确认" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="ConfirmCloseAllToggle" Style="{StaticResource SettingSwitch}" Toggled="ConfirmCloseAll_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="流量人性化显示（KB/MB）" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="HumanTrafficToggle" Style="{StaticResource SettingSwitch}" Toggled="HumanTraffic_Toggled"/>
                                        </Grid>
                                        <Grid Style="{StaticResource SettingRow}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="使用 Beta 更新通道" Style="{StaticResource SettingLabel}"/>
                                            <ui:ToggleSwitch Grid.Column="1" x:Name="BetaToggle" Style="{StaticResource SettingSwitch}" Toggled="Beta_Toggled"/>
                                        </Grid>
                                        <TextBlock Text="EasyTier 高级启动参数（附加到核心命令行，谨慎修改）" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                                        <TextBox x:Name="EtArgsBox" LostFocus="EtArgsBox_LostFocus" ToolTip="例如：--disable-encryption"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Style="{StaticResource NavHeader}"><ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PersonSettings_20_Regular}" Margin="0,0,10,0"/><TextBlock Text="关于" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
                <Grid Margin="24,16,16,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="关于 OpenP2P Launcher" Style="{StaticResource PageTitle}"/>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="帮助文档" Click="Openwiki" Margin="0,0,8,0"/><Button Grid.Column="1" Content="作者主页" Click="OpenMe" Margin="0,0,8,0"/><Button Grid.Column="2" Content="GitHub" Click="OpenGit"/>
                        <Button Grid.Column="4" x:Name="ExportLogButton" Content="导出日志" Click="ExportLog" Margin="0,0,8,0"/><Button Grid.Column="5" x:Name="ResetProgramButton" Content="重置程序" Click="ResetUID_Button_Click" ToolTip="重置 UID 并删除全部隧道配置"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*" MinWidth="180"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="更新日志" Style="{StaticResource SectionTitle}"/><TextBox Grid.Row="1" x:Name="uplogbox" Text="联网获取中" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="鸣谢" Style="{StaticResource SectionTitle}"/><TextBox Grid.Row="1" x:Name="thank" Text="联网获取中" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="2" Text="基于 OpenP2P · 内容联网获取" Style="{StaticResource Caption}" Margin="0,12,0,0"/></Grid></Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="#327F7F7F" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid x:Name="fstertHaloHost" Width="10" Height="22" Margin="0,0,8,0">
                    <Ellipse x:Name="fstert" Fill="Gray" Stroke="#667F7F7F" Width="10" Height="10"
                             VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Column="1" x:Name="ServiceStatusText" Text="服务未启动" VerticalAlignment="Center"/>
                <Label Grid.Column="2" x:Name="ver" Content="v1.0.1.9" Padding="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <Button Grid.Column="4" Content="导出连接码" Click="Outlist" Margin="0,0,8,0"/>
                <Button Grid.Column="5" Content="生成联机码" Click="Multput" Margin="0,0,8,0"/>
                <Button Grid.Column="6" x:Name="CloseAllButton" Content="关闭所有隧道" Click="CloseAll" Margin="0,0,8,0"/>
                <Button Grid.Column="7" x:Name="openbutton" Content="启动" Click="Button_Click_open" Width="112" Style="{StaticResource {x:Static ui:ThemeKeys.AccentButtonStyleKey}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
